    "“%@” Failed": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 실패"
          }
        }
      }
    },
    "%@ · not connected": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 연결 안 됨"
          }
        }
      }
    },
    "%@ %@ is available": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@을(를) 사용할 수 있습니다"
          }
        }
      }
    },
    "%@ doesn't update itself": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 스스로 업데이트하지 않습니다"
          }
        }
      }
    },
    "%@ has no menu bar to search": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 검색할 메뉴 막대가 없습니다"
          }
        }
      }
    },
    "%@ hasn't been downloaded yet.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)가 아직 다운로드되지 않았습니다."
          }
        }
      }
    },
    "%@ is up to date": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 최신 상태입니다"
          }
        }
      }
    },
    "%@ needs to be downloaded before it can be used.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(을)를 사용하려면 먼저 다운로드해야 합니다."
          }
        }
      }
    },
    "A custom command with this name already exists.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 사용자 설정 명령이 이미 있습니다."
          }
        }
      }
    },
    "A GitHub repository holding one folder per extension.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확장마다 폴더 하나인 GitHub 저장소입니다."
          }
        }
      }
    },
    "A layout puts named apps at fixed sizes on chosen displays, in one pass.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이아웃은 고른 디스플레이에 이름 있는 앱을 고정 크기로 한 번에 배치합니다."
          }
        }
      }
    },
    "A New Conversation": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 대화"
